@model List<SmartPark.Models.Rezervacija>

@{
    ViewData["Title"] = "Moje rezervacije";
}

<div class="sp-reservations-page">
    @if (!Model.Any())
    {
        <div class="alert alert-info">Trenutno nimaš rezervacij.</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
            @foreach (var r in Model)
            {
                var jePreteklo = r.Konec < DateTime.Now;
                var jeAktivno = r.Zacetek <= DateTime.Now && r.Konec >= DateTime.Now;

                <div class="col">
                    <article class="sp-reservation-card">
                        <div class="sp-reservation-card-header">
                            <div>
                                <span class="sp-reservation-label">Rezervacija #@r.Id</span>
                                <h2>@(r.Parkirisce?.Naslov ?? "Neznano parkirišče")</h2>
                            </div>
                            @if (jePreteklo)
                            {
                                <span class="sp-reservation-status is-expired">Poteklo</span>
                            }
                            else if (jeAktivno)
                            {
                                <span class="sp-reservation-status is-active">Aktivno</span>
                            }
                            else
                            {
                                <span class="sp-reservation-status is-upcoming">Prihajajoče</span>
                            }
                        </div>

                        <div class="sp-reservation-details">
                            <div>
                                <span>Mesto</span>
                                <strong>@(r.ParkirnoMesto?.Stevilka.ToString() ?? "-")</strong>
                            </div>
                            <div>
                                <span>Začetek</span>
                                <strong>@r.Zacetek.ToString("dd.MM.yyyy HH:mm")</strong>
                            </div>
                            <div>
                                <span>Konec</span>
                                <strong>@r.Konec.ToString("dd.MM.yyyy HH:mm")</strong>
                            </div>
                        </div>

                        @if (!jePreteklo)
                        {
                            <div class="sp-reservation-actions">
                                <form method="post" asp-controller="Rezervacije" asp-action="Cancel" asp-route-id="@r.Id">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-outline-danger btn-sm"
                                            onclick="return confirm('Ali res želiš preklicati rezervacijo?');">
                                        Prekliči rezervacijo
                                    </button>
                                </form>
                            </div>
                        }
                    </article>
                </div>
            }
        </div>
    }
</div>
@model IEnumerable<SmartPark.Models.Parkirisce>

@{
    ViewData["Title"] = "Domov";
}

<div class="sp-card sp-map-wrap">
    <div class="d-flex gap-2 mb-3 align-items-end flex-wrap">
        <div style="min-width:280px; flex:1;">
            <label class="form-label mb-1" style="margin-left: 7px; font-weight: bold;">Išči lokacijo</label>
            <input id="spLocalSearch" class="form-control" placeholder="npr. Kongresni trg" />
        </div>

        <div style="width:180px;">
            <label class="form-label mb-1" style="margin-left: 7px; font-weight: bold;">Max €/h</label>
            <input id="spMaxPrice" type="number" step="0.1" min="0" class="form-control" placeholder="npr. 3.0" />
        </div>

        <div>
            <button type="button" class="btn btn-outline-secondary" id="spClearFilters">Počisti</button>
        </div>
    </div>

   <div id="map" style="height: 600px; width:100%; border-radius:16px; overflow:hidden;"></div>
</div>
<!-- Modal za rezervacijo -->
<div class="modal fade" id="rezervacijaModal" tabindex="-1" aria-labelledby="rezervacijaModalLabel" aria-hidden="true">
   <div class="modal-dialog">
      <div class="modal-content">
         <form id="rezervacijaForm">
            @Html.AntiForgeryToken()
            <div class="modal-header">
               <h5 class="modal-title" id="rezervacijaModalLabel">Rezervacija parkirišča</h5>
               <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zapri"></button>
            </div>
            <div class="modal-body">
               <div class="sp-reservation-stepper" aria-label="Koraki rezervacije">
                  <div class="is-active" data-step-indicator="1"><span>1</span><strong>Termin</strong></div>
                  <div data-step-indicator="2"><span>2</span><strong>Mesto</strong></div>
                  <div data-step-indicator="3"><span>3</span><strong>Povzetek</strong></div>
               </div>

               <input type="hidden" id="parkId" name="ParkirisceId" />
               <input type="hidden" id="parkPrice" />
               <input type="hidden" id="parkirnoMestoId" name="ParkirnoMestoId" />

               <div class="sp-reservation-step" data-reservation-step="1">
                  <div class="sp-reservation-location">
                     <span>Parkirišče</span>
                     <strong id="parkNaslov"></strong>
                  </div>
                  <div class="sp-reservation-time-grid">
                     <div class="mb-3">
                        <label class="form-label" for="startTime">Začetek</label>
                        <input type="datetime-local" id="startTime" name="DatumZacetka" class="form-control" required />
                     </div>
                     <div class="mb-3">
                        <label class="form-label" for="endTime">Konec</label>
                        <input type="datetime-local" id="endTime" name="DatumKonca" class="form-control" required />
                     </div>
                  </div>
                  <div id="reservationStepError" class="text-danger small" role="alert"></div>
               </div>

               <div class="sp-reservation-step d-none" data-reservation-step="2">
                  <div id="seatPicker" class="sp-seat-picker mb-3 d-none">
                     <div class="sp-seat-picker-header">
                        <div>
                           <label class="form-label mb-1">Izberi parkirno mesto</label>
                           <p class="sp-seat-picker-help mb-0">Izbira je na voljo za manjša parkirišča.</p>
                        </div>
                        <span id="seatPickerCount" class="sp-seat-picker-count"></span>
                     </div>
                     <div id="seatGrid" class="sp-seat-grid" role="group" aria-label="Parkirna mesta"></div>
                  </div>
                  <div class="sp-seat-auto-note d-none" id="seatAutoNote">
                     Za to parkirišče bo sistem izbral prvo prosto mesto.
                  </div>
                  <div class="alert alert-info py-2 mb-0" id="availabilityInfo">
                     Izberi prosto mesto za nadaljevanje.
                  </div>
               </div>

               <div class="sp-reservation-step d-none" data-reservation-step="3">
                  <div class="sp-reservation-summary">
                     <div>
                        <span>Parkirišče</span>
                        <strong id="summaryParking"></strong>
                     </div>
                     <div>
                        <span>Termin</span>
                        <strong id="summaryTime"></strong>
                     </div>
                     <div>
                        <span>Parkirno mesto</span>
                        <strong id="summarySeat"></strong>
                     </div>
                     <div>
                        <span>Cena na uro</span>
                        <strong id="parkCena"></strong>
                     </div>
                     <div class="sp-reservation-summary-total">
                        <span>Skupna cena</span>
                        <strong id="totalPrice">0.00 €</strong>
                     </div>
                  </div>
               </div>
            </div>
            <div class="modal-footer">
               <button type="button" class="btn btn-light d-none" id="reservationBackBtn">Nazaj</button>
               <button type="button" class="btn btn-outline-secondary" id="cancelRezervacijaBtn">Prekliči</button>
               <button type="button" class="btn btn-primary" id="reservationNextBtn">Naprej</button>
               <button type="submit" class="btn btn-primary d-none" id="submitRezervacijaBtn" disabled>
                  Nadaljuj na plačilo
               </button>
            </div>
         </form>
      </div>
   </div>
</div>
<!-- Modal za plačilo -->
<div class="modal fade" id="placiloModal" tabindex="-1" aria-hidden="true">
   <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content sp-payment-modal">
         <div class="modal-header sp-payment-header">
            <div>
               <span class="sp-payment-eyebrow">Zaključi rezervacijo</span>
               <h5 class="modal-title">Plačilo rezervacije</h5>
               <p class="sp-payment-subtitle mb-0">Plačilo je varno in trenutno poteka v demo načinu.</p>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zapri"></button>
         </div>
         <div class="modal-body">
            <input type="hidden" id="rezervacijaIdHidden" />
            <div class="sp-payment-layout">
               <div class="sp-payment-summary">
                  <span class="sp-payment-eyebrow">Način plačila</span>
                  <label class="form-label" for="paymentMethod">Izberi način</label>
                  <select id="paymentMethod" class="form-select">
                     <option value="card">Bančna kartica</option>
                     <option value="nalog">Plačilni nalog</option>
                  </select>
                  <div class="sp-payment-note">
                     <span aria-hidden="true">✓</span>
                     Podatki se uporabljajo samo za predstavitev plačilnega koraka.
                  </div>
               </div>

               <div id="cardFields" class="sp-card-payment-fields" style="display:none;">
                  <div class="sp-payment-card-preview">
                     <div class="sp-payment-card-brand">SMARTPARK</div>
                     <div id="cardPreviewNumber" class="sp-payment-card-number">1234 5678 9012 3456</div>
                     <div class="sp-payment-card-footer">
                        <span>VARNOSTNO PLAČILO</span>
                        <strong>VISA</strong>
                     </div>
                  </div>
                  <div class="sp-payment-fields">
                     <div class="mb-3">
                        <label class="form-label" for="cardName">Ime na kartici</label>
                        <input id="cardName" class="form-control" autocomplete="cc-name" maxlength="50" placeholder="JANEZ NOVAK" required />
                     </div>
                     <div class="mb-3">
                        <label class="form-label" for="cardNumber">Številka kartice</label>
                        <input id="cardNumber" class="form-control" inputmode="numeric" autocomplete="cc-number" maxlength="19" placeholder="1234 5678 9012 3456" required />
                     </div>
                     <div class="row">
                        <div class="col-6 mb-3">
                           <label class="form-label" for="cardExp">Veljavnost (MM/YY)</label>
                           <input id="cardExp" class="form-control" inputmode="numeric" autocomplete="cc-exp" maxlength="5" placeholder="MM/YY" required />
                        </div>
                        <div class="col-6 mb-3">
                           <label class="form-label" for="cardCvv">CVV</label>
                           <input id="cardCvv" class="form-control" inputmode="numeric" autocomplete="cc-csc" maxlength="3" placeholder="123" required />
                        </div>
                     </div>
                  </div>
                  <div class="small text-muted">
                     Demo validacija ne izvede prave transakcije.
                  </div>
               </div>
            </div>
         </div>
         <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Prekliči</button>
            <button type="button" class="btn btn-primary sp-payment-submit" onclick="simulatePayment()">Plačaj</button>
         </div>
      </div>
   </div>
</div>

@section Scripts {
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
    var map = L.map('map').setView([46.0511, 14.5051], 17);

    L.tileLayer('https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; Stadia Maps &copy; OSM',
        maxZoom: 20
    }).addTo(map);

    var parkirisca = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model,
        new System.Text.Json.JsonSerializerOptions {
            ReferenceHandler = System.Text.Json.Serialization.ReferenceHandler.IgnoreCycles
        }
    ));

    const seatPickerLimit = 40;
    let activeParking = null;
    let availableSeatIds = [];

    function setAvailability(message, type) {
        const el = document.getElementById('availabilityInfo');
        const btn = document.getElementById('submitRezervacijaBtn');

        el.classList.remove('alert-info', 'alert-success', 'alert-danger');
        el.classList.add(type === 'ok' ? 'alert-success' : type === 'bad' ? 'alert-danger' : 'alert-info');
        el.textContent = message;

        // enable submit samo, če imamo veljavno mestoId
        const mestoId = document.getElementById('parkirnoMestoId').value;
        const hasTimes = document.getElementById('startTime').value && document.getElementById('endTime').value;
        btn.disabled = (!mestoId || mestoId === "0" || !hasTimes || type === 'bad');
    }

    async function fetchProstoMesto() {
        var parkId = document.getElementById('parkId').value;
        var start = document.getElementById('startTime').value;
        var end = document.getElementById('endTime').value;

        const parking = parkirisca.find(x => x.Id.toString() === parkId.toString());
        const usesSeatPicker = parking && (parking.ParkirnaMesta?.length || 0) > 0 &&
            parking.ParkirnaMesta.length <= seatPickerLimit;

        document.getElementById('submitRezervacijaBtn').disabled = true;

        if (!parkId || !start || !end) {
            if (usesSeatPicker) {
                document.getElementById('parkirnoMestoId').value = "0";
                resetSeatAvailability();
            }
            setAvailability("Izberi začetek in konec za preverjanje prostih mest.", "info");
            return;
        }

        // validacija na frontendu
        var diffMs = new Date(end) - new Date(start);
        if (diffMs <= 0) {
            setAvailability("Neveljaven interval (konec mora biti po začetku).", "bad");
            return;
        }

        if (usesSeatPicker) {
            await fetchSmallParkingAvailability(parking, start, end);
            return;
        }

        const url = `/Rezervacije/GetProstoMesto?parkirisceId=${encodeURIComponent(parkId)}&zacetek=${encodeURIComponent(start)}&konec=${encodeURIComponent(end)}`;

        try {
            const res = await fetch(url);
            const mestoId = await res.json();

            document.getElementById('parkirnoMestoId').value = (mestoId ?? 0).toString();

            if (!mestoId || mestoId === 0) {
                setAvailability("Ni prostih mest za izbrani termin. Poskusi drug termin.", "bad");
            } else {
                setAvailability("Prosto mesto je na voljo.", "ok");
            }
        } catch (e) {
            console.error(e);
            setAvailability("Napaka pri preverjanju prostih mest.", "bad");
        }
    }

    function usesSeatPicker(parking) {
        return parking && (parking.ParkirnaMesta?.length || 0) > 0 &&
            parking.ParkirnaMesta.length <= seatPickerLimit;
    }

    function updateSeatButtons() {
        document.querySelectorAll('#seatGrid .sp-seat-button').forEach(button => {
            const seatId = Number(button.dataset.seatId);
            const isAvailable = availableSeatIds.includes(seatId);
            const isSelected = document.getElementById('parkirnoMestoId').value === seatId.toString();

            button.disabled = !isAvailable;
            button.classList.toggle('is-available', isAvailable);
            button.classList.toggle('is-selected', isSelected);
            button.classList.toggle('is-occupied', !isAvailable);
        });
    }

    function resetSeatAvailability() {
        if (!activeParking || !usesSeatPicker(activeParking)) return;

        availableSeatIds = activeParking.ParkirnaMesta
            .filter(m => !m.Zasedeno)
            .map(m => m.Id);
        updateSeatButtons();
    }

    async function fetchSmallParkingAvailability(parking, start, end) {
        const url = `/Rezervacije/GetProstaMesta?parkirisceId=${encodeURIComponent(parking.Id)}&zacetek=${encodeURIComponent(start)}&konec=${encodeURIComponent(end)}`;

        try {
            const res = await fetch(url);
            availableSeatIds = await res.json();

            const selectedId = document.getElementById('parkirnoMestoId').value;
            if (!availableSeatIds.includes(Number(selectedId))) {
                document.getElementById('parkirnoMestoId').value = "0";
            }

            updateSeatButtons();

            if (availableSeatIds.length === 0) {
                setAvailability("Za izbrani termin ni prostih mest.", "bad");
            } else if (document.getElementById('parkirnoMestoId').value !== "0") {
                const selected = parking.ParkirnaMesta.find(m => m.Id.toString() === selectedId);
                setAvailability(`Izbrano mesto ${selected?.Stevilka ?? ""} je prosto.`, "ok");
            } else {
                setAvailability("Izberi eno od prostih parkirnih mest.", "info");
            }
        } catch (e) {
            console.error(e);
            setAvailability("Napaka pri preverjanju parkirnih mest.", "bad");
        }
    }

    function showRezervacijaModal() {
        var modal = new bootstrap.Modal(document.getElementById('rezervacijaModal'));
        modal.show();
    }

    let reservationStep = 1;

    function showReservationStep(step) {
        reservationStep = step;

        document.querySelectorAll('[data-reservation-step]').forEach(element => {
            element.classList.toggle('d-none', Number(element.dataset.reservationStep) !== step);
        });

        document.querySelectorAll('[data-step-indicator]').forEach(element => {
            element.classList.toggle('is-active', Number(element.dataset.stepIndicator) <= step);
        });

        document.getElementById('reservationBackBtn').classList.toggle('d-none', step === 1);
        document.getElementById('reservationNextBtn').classList.toggle('d-none', step === 3);
        document.getElementById('submitRezervacijaBtn').classList.toggle('d-none', step !== 3);
        document.getElementById('seatAutoNote').classList.toggle(
            'd-none',
            step !== 2 || usesSeatPicker(activeParking)
        );
    }

    function updateReservationSummary() {
        const selectedId = document.getElementById('parkirnoMestoId').value;
        const selectedSeat = activeParking?.ParkirnaMesta?.find(m => m.Id.toString() === selectedId);
        const start = document.getElementById('startTime').value.replace('T', ' ');
        const end = document.getElementById('endTime').value.replace('T', ' ');

        document.getElementById('summaryParking').textContent =
            document.getElementById('parkNaslov').textContent;
        document.getElementById('summaryTime').textContent = `${start} – ${end}`;
        document.getElementById('summarySeat').textContent =
            selectedSeat ? `Mesto ${selectedSeat.Stevilka}` : 'Samodejna dodelitev';
    }

    var spMarkers = [];

    parkirisca.forEach(function (p) {
        if (p.Latitude && p.Longitude) {
            var marker = L.marker([p.Latitude, p.Longitude]).addTo(map);

            marker.bindPopup(
            "<b>" + p.Naslov + "</b><br>" +
            "Cena na uro: " + p.CenaNaUro + " €<br>" +
            "Delovni čas: " + p.DelovniCas + "<br>" +
            "Prosta mesta: " + (p.ParkirnaMesta ? p.ParkirnaMesta.filter(m => !m.Zasedeno).length : 'N/A') +
            "<br><button class='btn btn-sm btn-primary mt-2' onclick='openRezervacija(" + p.Id + ")'>Rezerviraj</button>"
            );

            spMarkers.push({
            id: p.Id,
            title: (p.Naslov || ""),
            price: Number(p.CenaNaUro || 0),
            marker: marker
            });
        }
    });

    function applyFilters() {
        const q = (document.getElementById("spLocalSearch")?.value || "").toLowerCase().trim();
        const maxPriceRaw = (document.getElementById("spMaxPrice")?.value || "").trim();
        const maxPrice = maxPriceRaw ? Number(maxPriceRaw) : null;

        spMarkers.forEach(x => {
            const matchText = !q || (x.title || "").toLowerCase().includes(q);
            const matchPrice = (maxPrice == null) || (x.price <= maxPrice);

            const visible = matchText && matchPrice;
            if (visible) x.marker.addTo(map);
            else map.removeLayer(x.marker);
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        const s = document.getElementById("spLocalSearch");
        const p = document.getElementById("spMaxPrice");
        const c = document.getElementById("spClearFilters");

        if (s) s.addEventListener("input", applyFilters);
        if (p) p.addEventListener("input", applyFilters);

        if (c) {
            c.addEventListener("click", function () {
            if (s) s.value = "";
            if (p) p.value = "";
            applyFilters();
            });
        }
    });

    function resetRezervacijaForm() {
        document.getElementById('parkId').value = "";
        document.getElementById('parkNaslov').textContent = "";
        document.getElementById('parkPrice').value = "";
        document.getElementById('parkCena').textContent = "";
        document.getElementById('startTime').value = "";
        document.getElementById('endTime').value = "";
        document.getElementById('totalPrice').textContent = "0.00 €";
        document.getElementById('parkirnoMestoId').value = "0";
        document.getElementById('submitRezervacijaBtn').disabled = true;
        document.getElementById('reservationStepError').textContent = "";
        activeParking = null;
        availableSeatIds = [];
        document.getElementById('seatPicker').classList.add('d-none');
        document.getElementById('seatGrid').replaceChildren();
        setAvailability("Izberi začetek in konec za preverjanje prostih mest.", "info");
        showReservationStep(1);
    }

    function renderSeatPicker(parking) {
        activeParking = parking;
        const picker = document.getElementById('seatPicker');
        const grid = document.getElementById('seatGrid');

        if (!usesSeatPicker(parking)) {
            picker.classList.add('d-none');
            grid.replaceChildren();
            return;
        }

        picker.classList.remove('d-none');
        document.getElementById('seatPickerCount').textContent = `${parking.ParkirnaMesta.length} mest`;
        grid.replaceChildren();

        parking.ParkirnaMesta
            .slice()
            .sort((a, b) => a.Stevilka - b.Stevilka)
            .forEach(mesto => {
                const button = document.createElement('button');
                button.type = 'button';
                button.className = 'sp-seat-button';
                button.dataset.seatId = mesto.Id;
                button.textContent = mesto.Stevilka;
                button.title = mesto.Zasedeno ? 'Zasedeno' : `Mesto ${mesto.Stevilka}`;
                button.addEventListener('click', () => {
                    document.getElementById('parkirnoMestoId').value = mesto.Id;
                    updateSeatButtons();

                    const hasTimes = document.getElementById('startTime').value &&
                        document.getElementById('endTime').value;
                    setAvailability(
                        hasTimes
                            ? `Izbrano mesto ${mesto.Stevilka} je prosto.`
                            : `Izbrano mesto ${mesto.Stevilka}. Zdaj izberi termin.`,
                        hasTimes ? "ok" : "info"
                    );
                });
                grid.appendChild(button);
            });

        resetSeatAvailability();
    }

    function fillAndShowModal(p) {
        renderSeatPicker(p);
        document.getElementById('parkId').value = p.Id;
        document.getElementById('parkNaslov').textContent = p.Naslov;
        document.getElementById('parkPrice').value = p.CenaNaUro;
        document.getElementById('parkCena').textContent = p.CenaNaUro + " €";

        document.getElementById('startTime').value = "";
        document.getElementById('endTime').value = "";
        document.getElementById('totalPrice').textContent = "0.00 €";
        document.getElementById('parkirnoMestoId').value = "0";
        document.getElementById('reservationStepError').textContent = "";

        document.getElementById('startTime').onchange = updateTotal;
        document.getElementById('endTime').onchange = updateTotal;

        document.getElementById('submitRezervacijaBtn').disabled = true;
        setAvailability("Izberi začetek in konec za preverjanje prostih mest.", "info");
        showReservationStep(1);

        showRezervacijaModal();
    }

    function openRezervacija(id) {
        var p = parkirisca.find(x => x.Id === id);
        if (p) fillAndShowModal(p);
    }

    function updateTotal() {
        var start = document.getElementById('startTime').value;
        var end = document.getElementById('endTime').value;
        var pricePerHour = parseFloat(document.getElementById('parkPrice').value) || 0;

        if (!start || !end) {
            document.getElementById('totalPrice').textContent = "0.00 €";
            fetchProstoMesto();
            return;
        }

        var diffMs = new Date(end) - new Date(start);
        if (diffMs <= 0) {
            document.getElementById('totalPrice').textContent = "0.00 €";
            fetchProstoMesto();
            return;
        }

        var hours = diffMs / (1000 * 60 * 60);
        var total = hours * pricePerHour;

        document.getElementById('totalPrice').textContent = total.toFixed(2) + " €";
        fetchProstoMesto();
    }

    // Submit rezervacije -> odpre modal za plačilo
    document.addEventListener('DOMContentLoaded', function () {
        var form = document.getElementById('rezervacijaForm');

        function getAntiForgeryToken() {
            const tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');
            return tokenInput ? tokenInput.value : "";
        }

        // NOVO: Cancel gumb zapre modal in resetira
        document.getElementById('cancelRezervacijaBtn').addEventListener('click', function () {
            resetRezervacijaForm();
            const modalEl = document.getElementById('rezervacijaModal');
            const instance = bootstrap.Modal.getInstance(modalEl);
            if (instance) instance.hide();
        });

        document.getElementById('reservationBackBtn').addEventListener('click', function () {
            showReservationStep(Math.max(1, reservationStep - 1));
        });

        document.getElementById('reservationNextBtn').addEventListener('click', async function () {
            const error = document.getElementById('reservationStepError');

            if (reservationStep === 1) {
                const start = document.getElementById('startTime').value;
                const end = document.getElementById('endTime').value;

                if (!start || !end) {
                    error.textContent = "Izberi začetek in konec rezervacije.";
                    return;
                }

                if (new Date(end) <= new Date(start)) {
                    error.textContent = "Konec rezervacije mora biti po začetku.";
                    return;
                }

                error.textContent = "";
                await fetchProstoMesto();
                showReservationStep(2);
                return;
            }

            if (reservationStep === 2) {
                const mestoId = document.getElementById('parkirnoMestoId').value;
                if (!mestoId || mestoId === "0") {
                    setAvailability("Izberi prosto mesto za nadaljevanje.", "bad");
                    return;
                }

                updateReservationSummary();
                showReservationStep(3);
            }
        });

        form.addEventListener('submit', function (e) {
            e.preventDefault();

            // D) blokada submit, če je 0
            const mestoId = document.getElementById('parkirnoMestoId').value;
            if (!mestoId || mestoId === "0") {
                alert("Ni prostih mest za izbrani termin. Izberi drug termin ali drugo parkirišče.");
                return;
            }

            fetch('/Rezervacije/Create', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': getAntiForgeryToken()
                },
                body: new URLSearchParams(new FormData(form))
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    document.getElementById('rezervacijaIdHidden').value = data.rezervacijaId;

                    var rezervacijaModal = bootstrap.Modal.getInstance(document.getElementById('rezervacijaModal'));
                    rezervacijaModal.hide();

                    var placiloModal = new bootstrap.Modal(document.getElementById('placiloModal'));
                    placiloModal.show();
                } else {
                    alert(data.message || "Rezervacija ni uspela.");
                }
            })
            .catch(() => alert("Napaka pri komunikaciji s strežnikom."));
        });
    });

    function simulatePayment() {
        const rezervacijaId = document.getElementById("rezervacijaIdHidden").value;
        const method = document.getElementById("paymentMethod").value;

        if (!rezervacijaId) {
            alert("Manjka ID rezervacije. Najprej izvedi rezervacijo.");
            return;
        }

        if (method === "card") {
            const err = validateCardFields();
            if (err) { alert(err); return; }
        }

        fetch('/Placila/Create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ rezervacijaId: rezervacijaId, nacinPlacila: method })
        })
        .then(async r => {
            const text = await r.text();
            let data = null;
            try { data = JSON.parse(text); } catch {}

            if (!r.ok) {
            console.error("Placila/Create failed:", r.status, text);
            alert((data && data.message) ? data.message : ("Napaka pri plačilu (HTTP " + r.status + ")."));
            return;
            }

            if (data && data.success) {
            alert("Plačilo uspešno! Znesek: " + data.znesek + " €");
            window.location.href = "/Rezervacije/Index";
            } else {
            alert((data && data.message) ? data.message : "Napaka pri plačilu ❌");
            }
        })
        .catch(() => alert("Napaka pri komunikaciji s strežnikom."));
    }

    function normalizeCardNumber(v) {
        return (v || "").replace(/\s+/g, "");
    }

    function formatCardNumber(value) {
        return normalizeCardNumber(value).replace(/\D/g, "").substring(0, 16).replace(/(\d{4})(?=\d)/g, "$1 ");
    }

    function formatExpiry(value) {
        const digits = (value || "").replace(/\D/g, "").substring(0, 4);
        return digits.length > 2 ? digits.substring(0, 2) + "/" + digits.substring(2) : digits;
    }

    function validateCardFields() {
        const name = (document.getElementById("cardName").value || "").trim();
        const number = normalizeCardNumber(document.getElementById("cardNumber").value);
        const exp = (document.getElementById("cardExp").value || "").trim();
        const cvv = (document.getElementById("cardCvv").value || "").trim();

        if (!name) return "Vnesi ime na kartici.";
        if (name.length > 50) return "Ime na kartici je predolgo.";
        if (!/^\d{16}$/.test(number)) return "Številka kartice mora imeti 16 številk.";
        if (!/^\d{2}\/\d{2}$/.test(exp)) return "Veljavnost mora biti v obliki MM/YY.";
        const mm = parseInt(exp.substring(0,2), 10);
        if (isNaN(mm) || mm < 1 || mm > 12) return "Mesec veljavnosti mora biti med 01 in 12.";
        if (!/^\d{3}$/.test(cvv)) return "CVV mora imeti 3 številke.";
        return null;
    }

    document.addEventListener('DOMContentLoaded', function () {
        const paymentMethod = document.getElementById("paymentMethod");
        const cardFields = document.getElementById("cardFields");
        const cardName = document.getElementById("cardName");
        const cardNumber = document.getElementById("cardNumber");
        const cardExp = document.getElementById("cardExp");
        const cardCvv = document.getElementById("cardCvv");
        const cardPreviewNumber = document.getElementById("cardPreviewNumber");

        if (paymentMethod && cardFields) {
            const sync = () => {
            cardFields.style.display = (paymentMethod.value === "card") ? "" : "none";
            };
            paymentMethod.addEventListener("change", sync);
            sync();
        }

        if (cardName) {
            cardName.addEventListener("input", () => {
                cardName.value = cardName.value.replace(/[^\p{L}\s.'-]/gu, "").substring(0, 50);
            });
        }

        if (cardNumber) {
            cardNumber.addEventListener("input", () => {
                cardNumber.value = formatCardNumber(cardNumber.value);
                if (cardPreviewNumber) {
                    cardPreviewNumber.textContent = cardNumber.value || "1234 5678 9012 3456";
                }
            });
        }

        if (cardExp) {
            cardExp.addEventListener("input", () => {
                cardExp.value = formatExpiry(cardExp.value);
            });
        }

        if (cardCvv) {
            cardCvv.addEventListener("input", () => {
                cardCvv.value = cardCvv.value.replace(/\D/g, "").substring(0, 3);
            });
        }
    });

</script>
}
@using Microsoft.AspNetCore.Identity
@inject SignInManager<SmartPark.Models.ApplicationUser> SignInManager
@inject UserManager<SmartPark.Models.ApplicationUser> UserManager

@{
}

<style>
    .sp-auth {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
        align-items: stretch;
    }

    .sp-pill {
        display: block;
        width: 100%;
        text-align: center;
        padding: 10px 12px;
        border-radius: 14px;
        font-weight: 500;
        text-decoration: none;
        background: #fff;
        color: #242629;
        border: 1px solid #e4e7ec;
    }

    .sp-pill:hover { background: #f4f5f6; color: #242629; }

    .sp-logout-btn {
        width: 100%;
        border: 0;
        border-radius: 8px;
        padding: 10px 12px;
        font-weight: 500;
        background: #dc2626;
        color: #fff;
    }

    .sp-logout-btn:hover {
        background: #b91c1c;
    }
</style>

<ul class="sp-auth">
@if (SignInManager.IsSignedIn(User))
{
    <li>
        <form id="logoutForm" action="/Identity/Account/Logout?returnUrl=%2F" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="sp-logout-btn">Odjava</button>
        </form>
    </li>
}
else
{
    <li>
        <a class="sp-pill" href="/Identity/Account/Login">Prijava</a>
    </li>
    <li>
        <a class="sp-pill" href="/Identity/Account/Register">Registracija</a>
    </li>
}
</ul>
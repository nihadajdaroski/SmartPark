<!DOCTYPE html>
<html lang="sl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartPark</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SmartPark.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

    <style>
        html,
        body {
            height: 100%;
        }

        body.smartpark-body {
            margin: 0;
            overflow: hidden;
        }

        .sp-shell {
            height: 100vh;
        }

        .sp-content {
            height: 100vh;
            overflow: auto;
        }

        body.smartpark-body {
            background: radial-gradient(circle at 40% 0%, #f4f8ff, #eef4fb 35%, #f7fbff 100%);
        }

        .sp-shell {
            display: grid;
            grid-template-columns: 270px 1fr;
            min-height: 100vh;
        }

        .sp-sidebar {
            padding: 18px;
            background: linear-gradient(180deg, #0b3a66, #0a2f52);
            color: #fff;
            box-shadow: 0 12px 40px rgba(0, 0, 0, .16);
            position: sticky;
            top: 0;
            height: 100vh;

            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .sp-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 900;
            letter-spacing: .3px;
            font-size: 20px;
            text-decoration: none;
            color: #fff;
        }

        .sp-avatar {
            width: 46px;
            height: 46px;
            border-radius: 14px;
            background: rgba(255, 255, 255, .18);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 900;
        }

        .sp-usercard {
            background: rgba(255, 255, 255, .10);
            border-radius: 16px;
            padding: 12px;
        }

        .sp-usercard .name {
            font-weight: 900;
            margin: 0;
            font-size: 13px;
        }

        .sp-usercard .sub {
            opacity: .9;
            font-size: 12px;
            font-weight: 700;
        }

        .sp-usercard .role {
            margin-top: 4px;
            color: rgba(255, 255, 255, .72);
            font-size: 11px;
            font-weight: 750;
        }

        .sp-nav {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-top: 2px;
        }

        .sp-nav a {
            color: rgba(255, 255, 255, .92);
            text-decoration: none;
            padding: 12px 12px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 850;
        }

        .sp-nav a:hover {
            background: rgba(255, 255, 255, .12);
        }

        .sp-nav a.active {
            background: rgba(255, 255, 255, .18);
        }

        .sp-nav .sp-nav-heading {
            margin: 10px 12px 0;
            color: rgba(255, 255, 255, .62);
            font-size: 11px;
            font-weight: 850;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .sp-sidebar-footer {
            margin-top: auto;
            background: rgba(255, 255, 255, .10);
            border-radius: 16px;
            padding: 12px;
        }

        /* Topbar */
        .sp-content {
            padding: 18px 22px;
        }

        .sp-topbar {
            background: #fff;
            border-radius: 18px;
            padding: 14px 16px;
            box-shadow: 0 12px 30px rgba(0, 0, 0, .08);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 16px;
        }

        .sp-topbar h1 {
            font-size: 18px;
            font-weight: 900;
            margin: 0;
        }

        .sp-topbar .subtitle {
            margin: 0;
            font-size: 12px;
            color: #6b7280;
            font-weight: 750;
        }

        .sp-topbar-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .sp-auth-content {
            display: flex;
            align-items: flex-start;
            justify-content: center;
            padding-top: 8vh;
        }

        .sp-auth-shell {
            width: min(920px, 100%);
            display: grid;
            grid-template-columns: minmax(0, 1fr) 280px;
            gap: 18px;
        }

        .sp-auth-card,
        .sp-auth-aside {
            background: #fff;
            border-radius: 22px;
            box-shadow: 0 18px 45px rgba(11, 58, 102, .12);
        }

        .sp-auth-card {
            padding: clamp(24px, 5vw, 44px);
        }

        .sp-auth-card .eyebrow {
            color: #1d77ff;
            font-size: 12px;
            font-weight: 900;
            letter-spacing: .12em;
            text-transform: uppercase;
        }

        .sp-auth-card h1 {
            margin: 8px 0 8px;
            color: #0b3a66;
            font-size: clamp(28px, 4vw, 38px);
            font-weight: 900;
        }

        .sp-auth-card .intro {
            margin-bottom: 26px;
            color: #64748b;
            font-weight: 650;
        }

        .sp-auth-card .form-floating {
            margin-bottom: 16px !important;
        }

        .sp-auth-card .form-control {
            border-radius: 14px;
            border-color: #dbe5f0;
        }

        .sp-auth-card .btn-primary {
            border: 0;
            border-radius: 14px;
            padding: 12px 16px;
            background: #1d77ff;
            font-weight: 850;
        }

        .sp-auth-links {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            gap: 10px 18px;
            margin-top: 22px;
            font-weight: 750;
        }

        .sp-auth-links a {
            color: #1d64c8;
            text-decoration: none;
        }

        .sp-auth-links a:hover {
            text-decoration: underline;
        }

        .sp-auth-aside {
            padding: 28px;
            color: #fff;
            background: linear-gradient(160deg, #0b3a66, #155b93);
        }

        .sp-auth-aside h2 {
            margin: 0 0 12px;
            font-size: 22px;
            font-weight: 900;
        }

        .sp-auth-aside p {
            color: rgba(255, 255, 255, .78);
            line-height: 1.6;
        }

        .sp-auth-aside .sp-auth-feature {
            display: flex;
            gap: 10px;
            margin-top: 22px;
            color: rgba(255, 255, 255, .9);
            font-size: 13px;
            font-weight: 750;
        }

        .sp-content > * {
            animation: sp-page-enter .18s ease-out;
        }

        @@keyframes sp-page-enter {
            from {
                opacity: .72;
                transform: translateY(4px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .sp-search {
            display: flex;
            align-items: center;
            gap: 10px;
            background: #f4f7fb;
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            padding: 12px 14px;
        }

        .sp-search input {
            border: 0;
            outline: none;
            width: 100%;
            background: transparent;
            font-weight: 750;
        }

        /* _LoginPartial styling inside sidebar */
        .sp-loginpartial a,
        .sp-loginpartial button {
            font-weight: 850 !important;
        }

        /* Mobile */
        @@media (max-width: 992px) {
            .sp-shell {
                grid-template-columns: 1fr;
            }

            .sp-sidebar {
                position: relative;
                height: auto;
            }

            .sp-topbar {
                grid-template-columns: 1fr;
            }

            .sp-auth-shell {
                grid-template-columns: 1fr;
            }

            .sp-auth-aside {
                display: none;
            }
        }
    </style>
</head>

<body class="smartpark-body">
    <div class="sp-shell">

        <aside class="sp-sidebar">
            <a class="sp-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="sp-avatar">P</span>
                <span>SmartPark</span>
            </a>

            <div class="sp-usercard">
                <p class="name">@(User.Identity?.IsAuthenticated == true ? (User.Identity?.Name ?? "Uporabnik") : "Gost")</p>
                <div class="sub">Nadzorna plošča</div>
                @if (User.IsInRole("Administrator"))
                {
                    <div class="role">Administrator</div>
                }
            </div>

            @{
                var path = (Context.Request.Path.Value ?? "").ToLowerInvariant();
                var isAuthPage = path == "/identity/account/login" || path == "/identity/account/register";

                string ActiveExact(string exact) =>
                path == exact.ToLowerInvariant() ? "active" : "";

                string ActivePrefix(string prefix) =>
                path.StartsWith(prefix.ToLowerInvariant()) ? "active" : "";
            }

            @if (!isAuthPage)
            {
                <nav class="sp-nav">
                    <a class="@ActiveExact("/")" asp-controller="Home" asp-action="Index" data-sp-nav>Domov</a>

                    @if ((User.Identity?.IsAuthenticated ?? false) && !User.IsInRole("Administrator"))
                    {
                        <a class="@ActivePrefix("/rezervacije")" asp-controller="Rezervacije" asp-action="Index" data-sp-nav>Moje rezervacije</a>
                    }

                    @if (User.IsInRole("Administrator"))
                    {
                        <div class="sp-nav-heading">Administracija</div>
                        <a class="@ActivePrefix("/admin/parkirisca")" href="/admin/parkirisca" data-sp-nav>Parkirišča</a>
                        <a class="@ActivePrefix("/admin/rezervacije")" href="/admin/rezervacije" data-sp-nav>Rezervacije</a>
                        <a class="@ActivePrefix("/admin/placila")" href="/admin/placila" data-sp-nav>Plačila</a>
                    }
                </nav>
            }

            @if (!isAuthPage)
            {
                <div class="sp-sidebar-footer sp-loginpartial">
                    <partial name="_LoginPartial" />
                </div>
            }

        </aside>

        <main class="sp-content @(isAuthPage ? "sp-auth-content" : "")">
            @if (!isAuthPage)
            {
                <div class="sp-topbar">
                    <div>
                        <h1>@ViewData["Title"]</h1>
                        <p class="subtitle">Dobrodošel!</p>
                    </div>

                    <div style="font-size:12px; color:#6b7280; font-weight:850;">
                        @DateTime.Now.ToString("yyyy-MM-dd")
                    </div>
                    <div class="sp-topbar-actions">
                        @RenderSection("TopActions", required: false)
                    </div>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        document.addEventListener("click", function (event) {
            const link = event.target.closest("a[data-sp-nav]");
            if (!link || event.defaultPrevented || event.button !== 0 ||
                event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
                return;
            }

            document.querySelector(".sp-content")?.classList.add("sp-navigating");
        });
    </script>
</body>

</html>
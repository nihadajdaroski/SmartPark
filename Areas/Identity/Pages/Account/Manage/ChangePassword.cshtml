@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Spremeni geslo";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="sp-password-card">
    <div class="sp-password-header">
        <div class="sp-password-icon" aria-hidden="true">•••</div>
        <div>
            <div class="sp-password-eyebrow">Varnost računa</div>
            <h2>@ViewData["Title"]</h2>
            <p>Uporabi novo geslo, ki ga ne uporabljaš pri drugih računih.</p>
        </div>
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    <form id="change-password-form" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="sp-password-form-grid">
            <div class="form-floating">
                <input asp-for="Input.OldPassword"
                       class="form-control"
                       autocomplete="current-password"
                       aria-required="true"
                       placeholder="Trenutno geslo" />
                <label asp-for="Input.OldPassword"></label>
                <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
            </div>

            <div class="form-floating">
                <input asp-for="Input.NewPassword"
                       class="form-control"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="Novo geslo" />
                <label asp-for="Input.NewPassword"></label>
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>

            <div class="form-floating sp-password-full">
                <input asp-for="Input.ConfirmPassword"
                       class="form-control"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="Potrditev novega gesla" />
                <label asp-for="Input.ConfirmPassword"></label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
        </div>

        <div class="sp-password-actions">
            <button type="submit" class="btn btn-primary">
                Posodobi geslo
            </button>
            <a class="btn btn-light" asp-page="./Index">Nazaj na profil</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Ste pozabili geslo?";
}

<div class="sp-auth-shell">
    <section class="sp-auth-card">
        <div class="eyebrow">Varnost računa</div>
        <h1>Ponastavi geslo</h1>
        <p class="intro">Vnesi e-poštni naslov, povezan s tvojim računom, in poslali ti bomo navodila za ponastavitev gesla.</p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="form-floating">
                <input asp-for="Input.Email"
                       class="form-control"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="ime@primer.com" />
                <label asp-for="Input.Email">E-pošta</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <button type="submit" class="w-100 btn btn-lg btn-primary">
                Pošlji navodila
            </button>

            <div class="sp-auth-links">
                <a asp-page="./Login">Nazaj na prijavo</a>
                <a asp-page="./Register">Ustvari račun</a>
            </div>
        </form>

    </section>

    <aside class="sp-auth-aside">
        <h2>Obnovi dostop do računa</h2>
        <p>Po vnosu e-poštnega naslova preveri svojo pošto in sledi povezavi za varno ponastavitev gesla.</p>
        <div class="sp-auth-feature">✓ Povezava za ponastavitev je poslana na tvoj e-naslov</div>
        <div class="sp-auth-feature">✓ Račun ostane zaščiten</div>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
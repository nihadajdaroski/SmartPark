@page
@model LoginModel

@{
    ViewData["Title"] = "Prijava";
}

<div class="sp-auth-shell">
    <section class="sp-auth-card">
        <div class="eyebrow">SmartPark račun</div>
        <h1>Dobrodošel nazaj</h1>
        <p class="intro">Prijavi se za dostop do zemljevida, rezervacij in svojega uporabniškega računa.</p>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <div class="form-floating">
                <input asp-for="Input.Email"
                       class="form-control"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="ime@primer.com" />
                <label asp-for="Input.Email" class="form-label">E-pošta</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-floating">
                <input asp-for="Input.Password"
                       class="form-control"
                       autocomplete="current-password"
                       aria-required="true"
                       placeholder="geslo" />
                <label asp-for="Input.Password" class="form-label">Geslo</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="checkbox mb-4">
                <label asp-for="Input.RememberMe" class="form-label">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    @Html.DisplayNameFor(m => m.Input.RememberMe)
                </label>
            </div>

            <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">
                Prijava
            </button>

            <div class="sp-auth-links">
                <a id="forgot-password" asp-page="./ForgotPassword">Ste pozabili geslo?</a>
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Ustvari račun</a>
            </div>
        </form>
    </section>

    <aside class="sp-auth-aside">
        <h2>Parkiranje brez zapletov</h2>
        <p>Na enem mestu poišči parkirišče, preveri razpoložljivost in upravljaj svoje rezervacije.</p>
        <div class="sp-auth-feature">✓ Pregled parkirišč v Ljubljani</div>
        <div class="sp-auth-feature">✓ Hitra in varna prijava</div>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
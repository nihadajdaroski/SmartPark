@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Ponastavi geslo";
}

<div class="sp-auth-shell sp-reset-password-shell">
    <section class="sp-auth-card">
        <div class="eyebrow">Varnost računa</div>
        <h1>Ponastavi geslo</h1>
        <p class="intro">Izberi novo, varno geslo za svoj SmartPark račun.</p>

        <form method="post" class="sp-reset-password-form">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <input asp-for="Input.Code" type="hidden" />

            <div class="form-floating">
                <input asp-for="Input.Email"
                       class="form-control"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="ime@primer.com" />
                <label asp-for="Input.Email">E-pošta</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-floating">
                <input asp-for="Input.Password"
                       class="form-control"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="Novo geslo" />
                <label asp-for="Input.Password">Novo geslo</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-floating">
                <input asp-for="Input.ConfirmPassword"
                       class="form-control"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="Ponovi novo geslo" />
                <label asp-for="Input.ConfirmPassword">Ponovi novo geslo</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="w-100 btn btn-lg btn-primary">Shrani novo geslo</button>
        </form>

        <div class="sp-auth-links">
            <a asp-page="./Login">Nazaj na prijavo</a>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}